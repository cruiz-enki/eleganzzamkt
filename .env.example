VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Llave de servicio de Supabase. SOLO servidor: sin prefijo VITE_ a proposito,
# para que Vite no la meta en el bundle del navegador. La usan las server
# functions (src/lib/supabase-admin.ts) para no depender del rol anon.
SUPABASE_SERVICE_ROLE_KEY=

VITE_PUBLIC_APP_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Conexion con Google Drive (preferida): pega aqui el JSON completo de la
# cuenta de servicio. No caduca. Comparte la unidad compartida de Drive con
# el client_email de esa cuenta, como Administrador de contenido.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Metodo anterior (OAuth con refresh token). Solo se usa si no hay cuenta de
# servicio configurada. OJO: el refresh token caduca.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
AIRTABLE_API_KEY=
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
